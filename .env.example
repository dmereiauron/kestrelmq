# Runtime Environment
NODE_ENV=development
PORT=3000

# PostgreSQL 18 Container Settings (used by docker-compose.yml)
POSTGRES_USER=kestrelmq
POSTGRES_PASSWORD=<replace-with-postgres-password>
POSTGRES_DB=kestrelmq
POSTGRES_PORT=5432

# Redis 8.2 Container Settings (used by docker-compose.yml)
REDIS_PORT=6379

# Application Connection URLs (validated by src/config/env.validation.ts)
POSTGRES_URL=postgresql://kestrelmq:<replace-with-postgres-password>@localhost:5432/kestrelmq?schema=public
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets
# APP_SECRET: minimum 32 characters (application & token signing)
APP_SECRET=<replace-with-min-32-char-random-secret>
# ENCRYPTION_MASTER_KEY: exact 64 hex characters (32 bytes / 256 bits for AES-256-GCM)
ENCRYPTION_MASTER_KEY=<replace-with-64-hex-char-master-key>
