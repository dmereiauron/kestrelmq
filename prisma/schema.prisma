generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum WorkspacePlan {
  FREE
  PRO
  ENTERPRISE

  @@map("workspace_plan")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  VIEWER

  @@map("workspace_role")
}

enum IntegrationChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK

  @@map("integration_channel")
}

enum IntegrationProvider {
  MAILGUN
  RESEND
  SMTP
  TELEGRAM_BOT
  CUSTOM_WEBHOOK

  @@map("integration_provider")
}

enum EventDirection {
  OUTBOUND
  INBOUND

  @@map("event_direction")
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  RETRYING
  DELIVERED
  FAILED
  CANCELED
  PAUSED

  @@map("delivery_status")
}

enum SchemaValidationMode {
  DISABLED
  WARN
  STRICT

  @@map("schema_validation_mode")
}

enum InboundProviderType {
  STRIPE
  SHOPIFY
  GITHUB
  CUSTOM_HMAC
  NONE

  @@map("inbound_provider_type")
}

// -----------------------------------------------------------------------------
// Models (12 Tables matching SPEC.md Section 4)
// -----------------------------------------------------------------------------

/// 1. System user accounts
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspaceMembers WorkspaceMember[]

  @@map("users")
}

/// 2. Isolated multi-tenant workspaces
model Workspace {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String        @unique
  plan                 WorkspacePlan @default(FREE)
  webhookSigningSecret String        @map("webhook_signing_secret")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  members        WorkspaceMember[]
  apiKeys        ApiKey[]
  integrations   Integration[]
  templates      Template[]
  routingRules   RoutingRule[]
  events         Event[]
  deliveries     Delivery[]
  eventSchemas   EventSchema[]
  inboundSources InboundSource[]

  @@map("workspaces")
}

/// 3. User-to-workspace membership & RBAC
model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

/// 4. Ingestion API authentication keys
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  keyHash     String    @unique @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

/// 5. External provider configurations
model Integration {
  id                   String              @id @default(uuid()) @db.Uuid
  workspaceId          String              @map("workspace_id") @db.Uuid
  name                 String
  channel              IntegrationChannel
  provider             IntegrationProvider
  encryptedCredentials String              @map("encrypted_credentials") @db.Text
  iv                   String
  authTag              String              @map("auth_tag")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routingRules RoutingRule[]
  deliveries   Delivery[]

  @@map("integrations")
}

/// 6. Message templates
model Template {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  name            String
  subjectTemplate String?  @map("subject_template")
  bodyTemplate    String   @map("body_template") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routingRules RoutingRule[]

  @@map("templates")
}

/// 7. Event-to-channel routing rules
model RoutingRule {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  eventName      String   @map("event_name")
  integrationId  String   @map("integration_id") @db.Uuid
  templateId     String?  @map("template_id") @db.Uuid
  targetOverride String?  @map("target_override")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  template    Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries  Delivery[]

  @@index([workspaceId, eventName, isActive])
  @@map("routing_rules")
}

/// 8. Ingested events log
model Event {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  idempotencyKey  String?        @map("idempotency_key")
  eventName       String         @map("event_name")
  recipient       Json
  payload         Json
  scheduledFor    DateTime?      @map("scheduled_for")
  schemaWarnings  Json?          @map("schema_warnings")
  direction       EventDirection @default(OUTBOUND)
  inboundSourceId String?        @map("inbound_source_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboundSource InboundSource? @relation(fields: [inboundSourceId], references: [id], onDelete: SetNull)
  deliveries    Delivery[]

  @@unique([workspaceId, idempotencyKey], where: { idempotencyKey: { not: null } })
  @@map("events")
}

/// 9. Individual delivery tasks
model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  routingRuleId String?        @map("routing_rule_id") @db.Uuid
  integrationId String?        @map("integration_id") @db.Uuid
  status        DeliveryStatus @default(PENDING)
  attemptCount  Int            @default(0) @map("attempt_count")
  maxAttempts   Int            @default(5) @map("max_attempts")
  nextRetryAt   DateTime?      @map("next_retry_at")
  deliveredAt   DateTime?      @map("delivered_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  routingRule RoutingRule?      @relation(fields: [routingRuleId], references: [id], onDelete: SetNull)
  integration Integration?      @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  attempts    DeliveryAttempt[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("deliveries")
}

/// 10. Execution attempt audit logs
model DeliveryAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  deliveryId     String   @map("delivery_id") @db.Uuid
  attemptNumber  Int      @map("attempt_number")
  requestPayload Json     @map("request_payload")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") @db.Text
  errorMessage   String?  @map("error_message") @db.Text
  durationMs     Int      @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}

/// 11. Custom event schemas for validation and autocomplete
model EventSchema {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  eventName      String               @map("event_name")
  samplePayload  Json                 @map("sample_payload")
  jsonSchema     Json                 @map("json_schema")
  validationMode SchemaValidationMode @default(DISABLED) @map("validation_mode")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventName])
  @@map("event_schemas")
}

/// 12. Inbound webhook gateway endpoints
model InboundSource {
  id                     String              @id @default(uuid()) @db.Uuid
  workspaceId            String              @map("workspace_id") @db.Uuid
  name                   String
  sourceSlug             String              @unique @map("source_slug")
  providerType           InboundProviderType @map("provider_type")
  encryptedSigningSecret String?             @map("encrypted_signing_secret") @db.Text
  iv                     String?
  authTag                String?             @map("auth_tag")
  targetUrl              String              @map("target_url")
  maxRatePerSec          Int                 @default(10) @map("max_rate_per_sec")
  isPaused               Boolean             @default(false) @map("is_paused")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    Event[]

  @@map("inbound_sources")
}
