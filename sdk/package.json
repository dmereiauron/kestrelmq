{
  "name": "@kestrelmq/sdk",
  "version": "0.1.0",
  "description": "Zero-dependency strongly typed TypeScript client SDK for KestrelMQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmereiauron/kestrelmq.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {}
}
