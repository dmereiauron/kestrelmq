{
  "name": "kestrelmq",
  "version": "0.1.0",
  "description": "Self-hosted multi-tenant notification orchestration and guaranteed webhook delivery platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "build": "prisma generate && nest build",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:typecheck": "npm --prefix sdk run typecheck",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "start:worker:prod": "node dist/worker.js",
    "typecheck": "tsc --noEmit && npm --prefix sdk run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.10",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "handlebars": "^4.7.10",
    "ioredis": "^6.1.0",
    "json-logic-js": "^2.0.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.2",
    "prisma": "^7.10.1",
    "testcontainers": "^12.2.2",
    "typescript": "^6.0.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
